#!/bin/bash

load_image() {
    
    echo "$(echo "Loading")" "$(echo $1)"

    minikube image load $1

    echo "$(echo "Loaded")" "$(echo $1)"
}

build_image() {
    
    ################################################
    # Gerando a imagem docker
    ################################################
    
    # eval ${minikube docker-env}

    cd image

    docker build . -t devopsufscar/hello-config-file

    load_image devopsufscar/hello-config-file

    cd ..
}

init_minikube() {

    ################################################
    # Inicializando o Minikube
    ################################################

    minikube start

    ################################################
    # Habilitando o Ingress
    ################################################

    minikube addons enable ingress

    ################################################
    # Inicializando o DashBoard
    ################################################

    minikube addons enable dashboard

    minikube addons enable metrics-server

    minikube dashboard &
}

################################################
# Verificando flags -ib
################################################

while getopts ":ib" option; do
   case $option in
      i) # initialize/start minikube
         init_minikube
         ;;  
      b) # build image
         build_image
         ;;
   esac
done

################################################
# Configurando o K8s
################################################

kubectl apply -f configmap.yaml; kubectl apply -f deployment.yaml

kubectl wait --for=jsonpath='{.status.phase}'=Running $(kubectl get pods -o=name) --timeout=300s

kubectl apply -f service.yaml ; kubectl apply -f ingress.yaml
