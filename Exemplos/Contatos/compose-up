#!/bin/bash

build_backend_image() {
    
    ################################################
    # Gerando a imagem docker do backend
    ################################################
    
    cd backend
    
    mvn package
    
    mvn clean
    
    cd ..
}

build_frontend_image() {
    
    ################################################
    # Gerando a imagem docker do frontend
    ################################################
    
    cd frontend
    
    docker build . -t devopsufscar/contatos-v1-frontend
    
    cd ..
}

while getopts ":bf" option; do
   case $option in
      b) # build backend image
         build_backend_image
         ;;
      f) # build frontend image
         build_frontend_image
         ;;
   esac
done

################################################
# Executando o docker compose (UP)
################################################

docker compose up
